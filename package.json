{
  "name": "training-ai-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src/frontend tests/frontend eslint.config.js vite.config.ts playwright.config.ts && prettier --check src/frontend tests/frontend eslint.config.js vite.config.ts playwright.config.ts package.json tsconfig.json index.html",
    "lint-fix": "eslint src/frontend tests/frontend eslint.config.js vite.config.ts playwright.config.ts --fix && prettier --write src/frontend tests/frontend eslint.config.js vite.config.ts playwright.config.ts package.json tsconfig.json index.html",
    "test-e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "5.0.58",
    "@assistant-ui/react": "0.15.32",
    "@assistant-ui/react-markdown": "0.14.24",
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "ai": "7.0.137",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "lucide-react": "1.66.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "4.0.1",
    "tw-animate-css": "1.4.0",
    "tw-shimmer": "0.4.14",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
