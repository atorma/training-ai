# Provider-specific API key (e.g., OpenAI).
OPENAI_API_KEY=
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
# Use Responses for OpenAI reasoning models with MCP tools.
MODEL=openai-responses:gpt-5
# User timezone for the chat agent's live date/time context (IANA name).
TIMEZONE=Europe/Helsinki

# Optional: override base instructions/user message
# BASE_INSTRUCTIONS=
# SUMMARY_USER_MESSAGE=

# If the MCP server has basic authentication, add these
# MCP_BASIC_AUTH_USERNAME=
# MCP_BASIC_AUTH_PASSWORD=

# To use an _external_ signal-cli-rest-api to send a training summary to your own Signal account, add these
# SIGNAL_API_URL=
# SIGNAL_NUMBER=
# These are optional. Use if your signal-cli-rest-api has basic auth.
# SIGNAL_BASIC_AUTH_USERNAME=
# SIGNAL_BASIC_AUTH_PASSWORD=

# To use Logfire
# LOGFIRE_ENVIRONMENT=
# Optional: send telemetry to Logfire when a token is configured.
# LOGFIRE_TOKEN=
# Local durable web conversation storage (ignored by Git).
DATABASE_PATH=data/conversations.sqlite3
# Observation retrieval window (days), not an expiration policy.
MEMORY_OBSERVATION_DAYS=30
# Required memory/retry context in compact JSON characters; overflow fails before provider use.
MEMORY_CONTEXT_BUDGET=12000
# Separate recent-observation and complete-history selection allowances.
MEMORY_OBSERVATION_BUDGET=4000
CONVERSATION_HISTORY_BUDGET=64000
