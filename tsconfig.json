{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/frontend/*"]
    }
  },
  "include": [
    "src/frontend",
    "tests/frontend",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
